!Acessando ao nodo de Configuração Global de comandos
configure terminal

    !Configuração do nome de dominío FQDN(Fully Qualified Domain Name) do Switch
    ip domain-name my.rede

    !Criação da chave de criptografia e habilitar oo serviço de SSH no server local
    crypto key generate rsa general modulus 1024

    !Habilitando a versão 2 do serviço de SSH server
    ip ssh version 2

    !Hablitando o tempo de inatividade para novas conexões do SSH Server
    ip ssh time-out 60

    !Hablitando o número máximo de tentativas de conexões simultâneas no SSH Server
    ip ssh authentication-retries 2

    !Saida de todos os níveis e voltando para o modo EXEC Privilegiado
    end 

!Salvando as configurações nda RAM para a NVRAM
!OBSERVAÇÃO IMPORTANTE: deixar uma linha em branco no final do script para
!salvar automaticamente o script na hora da execução, fazendo a função de
write
